<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Matches app.json's expo.android.permissions for the RN baseline
        (see MIGRATION_STATUS.md Phase 0). Only RECORD_AUDIO is added here,
        in Phase 3, because it's the only one this phase's code actually
        uses; FOREGROUND_SERVICE/_MICROPHONE belong with whichever later
        phase actually needs a foreground service.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Needed for SttModelManager.kt's model download (the one piece of
        real RN behavior this permission enables — Expo/RN apps carry this
        permission unconditionally by default, since Metro/networking is
        assumed baseline; it was never explicitly listed in app.json's
        android.permissions array because that array is only for
        dangerous/runtime permissions, not this normal-protection one).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        UdpTransport reports link state from what it actually observes (a
        frame arriving from the peer), not from the OS, so this is only for
        surfacing why a link cannot come up. Normal-protection, not runtime.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A received CRITICAL message vibrates as well as speaking, so it
        registers when the handset is not being looked at. Normal-protection,
        no runtime prompt.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        A CRITICAL message raises the media stream to maximum for the length
        of that message, then puts the operator's level back. Without this
        permission setStreamVolume is ignored silently - no exception, no
        effect - which is exactly how it failed the first time.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.iTantra"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.iTantra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
