# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# android-native: the hand-authored native Kotlin application (tracked).
# Only its Gradle build output / local machine config is ignored.
/android-native/local.properties
/android-native/.gradle/
/android-native/.kotlin/
/android-native/build/
/android-native/app/build/
/android-native/app/.cxx/
# Native .so files extracted from the com.xdcobra.sherpa AARs by the
# extractSherpaOnnxNative/extractOnnxruntimeNative Gradle tasks in
# app/build.gradle.kts — 100+ MB, fully regenerated on every build from the
# pinned AAR versions, never hand-authored.
/android-native/app/src/main/jniLibs/

# scratch / temp / large model files
.scratch/
asr_release_tmp.json
tts_release_tmp.json

# planning & demo specs
implementation-plan.md
prototype-for-demo.md

